@app.post("/v1/devices")
def enroll_device():
    """Register the device's keys: one for request proofs, one for transaction signing."""
    rate_limit(f"ip:{request.remote_addr}:auth", 20, 60)
    d = body({"username": s(r"[a-z0-9_.-]+", 3, 32), "password": s(None, 1, 128),
              "otp": s(r"\d{6}", 6, 6), "auth_public_key": s(None, 50, 400),
              "tx_public_key": s(None, 50, 400), "attestation": s(None, 1, 4096)})
    auth_key, tx_key = load_pubkey(d["auth_public_key"]), load_pubkey(d["tx_public_key"])
    user = check_credentials(d["username"], d["password"], d["otp"])
    if not user or not verify_attestation(d["attestation"]):
        raise ApiError(401, "invalid_credentials")
    dev_id = "dev_" + secrets.token_hex(8)
    with LOCK:
        DEVICES[dev_id] = {"id": dev_id, "user": user["id"], "auth_key": auth_key,
                           "tx_key": tx_key, "revoked": False}
    audit("device_enrolled", user=user["id"], device=dev_id, ip=request.remote_addr)
    return jsonify({"device_id": dev_id}), 201


@app.delete("/v1/devices/<dev_id>")
@require_auth
def revoke_device(dev_id):
    dev = owned(DEVICES, dev_id)
    with LOCK:
        dev["revoked"] = True
        for fam in FAMILIES.values():
            if fam["device"] == dev_id:
                fam["revoked"] = True
    audit("device_revoked", user=g.user_id, device=dev_id)
    return "", 204


@app.post("/v1/auth/token")
def login():
    rate_limit(f"ip:{request.remote_addr}:auth", 20, 60)
    d = body({"username": s(r"[a-z0-9_.-]+", 3, 32), "password": s(None, 1, 128),
              "otp": s(r"\d{6}", 6, 6), "device_id": s(r"dev_[0-9a-f]{16}", 20, 20)})
    rate_limit(f"login:{d['username']}", 10, 60)
    dev = DEVICES.get(d["device_id"])
    if not dev or dev["revoked"]:
        raise ApiError(401, "invalid_credentials")
    verify_proof(dev["id"], dev["auth_key"], "")
    user = check_credentials(d["username"], d["password"], d["otp"])
    if not user or user["id"] != dev["user"]:
        raise ApiError(401, "invalid_credentials")
    audit("login_ok", user=user["id"], device=dev["id"], ip=request.remote_addr)
    return jsonify(issue_tokens(user["id"], dev["id"]))


@app.post("/v1/auth/refresh")
def refresh():
    """Rotating refresh tokens. The proof is bound to the refresh token itself."""
    rate_limit(f"ip:{request.remote_addr}:auth", 20, 60)
    d = body({"refresh_token": s(r"[A-Za-z0-9_-]+", 20, 100)})
    rec = REFRESH.get(b64u(sha256(d["refresh_token"].encode())))
    if not rec:
        raise ApiError(401, "invalid_token")
    fam = FAMILIES.get(rec["family"])
    dev = fam and DEVICES.get(fam["device"])
    if not dev or dev["revoked"]:
        raise ApiError(401, "invalid_token")
    # Prove device possession first, so outsiders can't trigger revocations.
    verify_proof(dev["id"], dev["auth_key"], b64u(sha256(d["refresh_token"].encode())))
    with LOCK:
        if rec["used"]:  # an old refresh token came back: assume theft, kill the family
            revoke_family(rec["family"])
            audit("refresh_reuse_detected", user=fam["user"], family=rec["family"])
            raise ApiError(401, "invalid_token")
        if fam["revoked"] or rec["exp"] < time.time():
            raise ApiError(401, "invalid_token")
        rec["used"] = True
        return jsonify(issue_tokens(fam["user"], dev["id"], family=rec["family"]))


@app.post("/v1/auth/logout")
@require_auth
def logout():
    revoke_family(g.family)
    audit("logout", user=g.user_id)
    return "", 204


@app.post("/v1/auth/step-up")
@require_auth
def step_up():
    d = body({"otp": s(r"\d{6}", 6, 6)})
    with LOCK:
        if not verify_totp(USERS[g.user_id], d["otp"]):
            audit("stepup_failed", user=g.user_id)
            raise ApiError(401, "invalid_credentials")
        FAMILIES[g.family]["stepup_until"] = time.time() + STEPUP_TTL
    audit("stepup_ok", user=g.user_id)
    return jsonify({"step_up_valid_for": STEPUP_TTL})


@app.get("/v1/accounts")
@require_auth
def list_accounts():
    return jsonify([{"id": a["id"], "currency": a["currency"],
                     "balance_minor": a["balance_minor"], "number": "**" + a["number"][-4:]}
                    for a in ACCOUNTS.values() if a["owner"] == g.user_id])


@app.get("/v1/accounts/<acc_id>/transactions")
@require_auth
def list_transactions(acc_id):
    owned(ACCOUNTS, acc_id)
    if set(request.args) - {"limit", "before_seq"}:
        raise ApiError(400, "unknown_params")
    lim, before = request.args.get("limit", "20"), request.args.get("before_seq", "")
    if not lim.isdigit() or not 1 <= int(lim) <= 50 or (before and not before.isdigit()):
        raise ApiError(400, "invalid_params")
    rows = [t for t in reversed(TXNS) if t["account_id"] == acc_id
            and (not before or t["seq"] < int(before))]
    return jsonify(rows[:int(lim)])


@app.post("/v1/beneficiaries")
@require_auth
def add_beneficiary():
    if time.time() > FAMILIES[g.family]["stepup_until"]:
        raise ApiError(403, "step_up_required")  # fresh second factor before a new payee
    d = body({"name": s(r"[A-Za-z0-9 .'-]+", 1, 60), "account_number": s(r"\d{8,16}", 8, 16),
              "bank_code": s(r"[A-Z0-9]{4,11}", 4, 11)})
    ben_id = "ben_" + secrets.token_hex(8)
    with LOCK:
        BENEFICIARIES[ben_id] = {"id": ben_id, "owner": g.user_id, **d}
    audit("beneficiary_added", user=g.user_id, beneficiary=ben_id)
    return jsonify({"id": ben_id, **d}), 201


@app.get("/v1/beneficiaries")
@require_auth
def list_beneficiaries():
    return jsonify([b for b in BENEFICIARIES.values() if b["owner"] == g.user_id])


@app.post("/v1/payments")
