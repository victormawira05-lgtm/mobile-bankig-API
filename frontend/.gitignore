* {
  box-sizing: border-box;
}

:root {
  color: #e5eefb;
  background: #0b1020;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #0b1020 0%, #101a2e 100%);
}

button,
input,
select {
  font: inherit;
}

button {
  background: #5a7cff;
  color: white;
  border: none;
  border-radius: 10px;
  padding: 0.8rem 1rem;
  cursor: pointer;
  font-weight: 600;
}

button:hover {
  filter: brightness(1.06);
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

button.danger {
  background: #d84343;
}

.page-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem 4rem;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.7rem;
  color: #8ca7d8;
}

h1 {
  margin: 0.25rem 0 0;
  font-size: 2.2rem;
}

h2 {
  margin-top: 0;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  margin-bottom: 1rem;
}

.card {
  background: rgba(17, 24, 39, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 18px;
  padding: 1.2rem;
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.25);
}

label {
  display: block;
  margin-bottom: 0.9rem;
  font-size: 0.9rem;
  color: #c9d6f0;
}

input,
select {
  width: 100%;
  margin-top: 0.35rem;
  padding: 0.8rem 0.9rem;
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.3);
  color: #edf3ff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin: 1rem 0;
  color: #dbe7ff;
}

.stack {
  display: grid;
  gap: 0.75rem;
}

.account-row {
  background: rgba(89, 118, 207, 0.18);
  color: white;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  padding: 0.9rem 1rem;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
}

.token-box {
  background: rgba(148, 163, 184, 0.12);
  border-radius: 12px;
  padding: 0.8rem;
  margin-top: 1rem;
  word-break: break-all;
}

.notice {
  margin-top: 1rem;
  border-radius: 12px;
  padding: 0.9rem 1rem;
  border: 1px solid transparent;
}

.notice.success {
  background: rgba(22, 101, 52, 0.2);
  border-color: rgba(34, 197, 94, 0.4);
  color: #d7fbd8;
}

.notice.error {
  background: rgba(127, 29, 29, 0.2);
  border-color: rgba(248, 113, 113, 0.5);
  color: #ffd2d2;
}

.list {
  padding-left: 1.2rem;
  color: #e5eefb;
  line-height: 1.8;
}

code {
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
  font-size: 0.8rem;
}
